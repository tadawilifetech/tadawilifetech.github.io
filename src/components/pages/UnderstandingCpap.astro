---
import { Icon } from "astro-icon/components";
import PageHero from "@components/pages/PageHero.astro";
import { type SiteLocale, localizePath } from "@utils/locale-utils";
import { url } from "@utils/url-utils";

interface Props {
	locale: SiteLocale;
}
const { locale } = Astro.props;

type Topic = [id: string, icon: string, title: string, text: string];
const c = {
	en: {
		title: "Understanding CPAP Therapy",
		lead: "Learn how CPAP therapy works and how it helps maintain an open airway during sleep.",
		toc: "On this page",
		topics: [
			["cpap", "material-symbols:air-rounded", "Understanding CPAP Therapy", "Learn how CPAP therapy works and how it helps maintain an open airway during sleep."],
			["bipap", "material-symbols:pulmonology-outline-rounded", "Understanding BiPAP Therapy", "Learn about BiPAP therapy, how it differs from CPAP, and its commonly prescribed applications for patients requiring additional respiratory support."],
			["mad", "material-symbols:dentistry-outline", "Understanding Oral Appliance Therapy (MAD)", "Learn about Mandibular Advancement Devices (MAD) and their role in the management of snoring and certain cases of obstructive sleep apnea."],
			["equipment", "material-symbols:devices-other-outline-rounded", "Choosing the Right Sleep Therapy Equipment", "Explore information about sleep therapy devices, masks, and accessories commonly used in sleep apnea management."],
			["getting-started", "material-symbols:rocket-launch-outline-rounded", "Getting Started with Therapy", "Practical guidance for individuals beginning sleep therapy, including helpful tips for improving comfort and adapting to therapy."],
			["mask-selection", "material-symbols:masks-outline-rounded", "Mask Selection Guide", "Learn about different mask types and important considerations when selecting a suitable mask."],
			["cleaning", "material-symbols:cleaning-services-outline-rounded", "Cleaning & Maintenance", "Guidance on proper cleaning, maintenance, and care of sleep therapy equipment."],
			["faq-tips", "material-symbols:tips-and-updates-outline-rounded", "Common Questions & Practical Tips", "Find answers to frequently asked questions and practical tips related to sleep therapy equipment and everyday use."],
			["resources", "material-symbols:library-books-outline-rounded", "Educational Resources", "Access educational articles, guides, videos, and informational materials related to sleep health and sleep therapy."],
		] as Topic[],
		links: { cpap: "Explore CPAP devices", masks: "See CPAP masks & videos", mad: "Oral appliances", videos: "Training videos", blog: "Articles & guides" },
		reportsTitle: "Understanding Sleep Study Reports",
		reportsSub: "Understanding Common Sleep Study Terms and Parameters",
		reportsIntro: [
			"Sleep studies provide valuable information about breathing patterns, oxygen levels, and other physiological parameters during sleep. Understanding some of the commonly used terms can help individuals become more familiar with the information that may appear in a sleep study report.",
			"The information provided below is intended for educational purposes and explains commonly used sleep study parameters and terminology.",
		],
		ahiTitle: "Apnea-Hypopnea Index (AHI)",
		ahi: [
			"The Apnea-Hypopnea Index (AHI) is one of the most commonly used parameters in sleep studies. It represents the frequency of breathing interruptions and reductions that occur during sleep.",
			"AHI is widely used in sleep medicine and is commonly referenced when classifying the severity of sleep-disordered breathing.",
		],
		ahiTable: "Commonly Used AHI Classification",
		ahiRows: [["Less than 5", "Normal"], ["5 to 14.9", "Mild"], ["15 to 29.9", "Moderate"], ["30 or higher", "Severe"]],
		ahiHead: ["AHI", "Classification"],
		terms: [
			["material-symbols:water-drop-outline-rounded", "Oxygen Desaturation Index (ODI)", "The Oxygen Desaturation Index (ODI) reflects the number of times oxygen levels decrease during sleep. ODI is commonly reviewed alongside other sleep study parameters to better understand oxygen-related changes that may occur during the night."],
			["material-symbols:spo2-outline-rounded", "Oxygen Saturation (SpO₂)", "Oxygen saturation (SpO₂) represents the percentage of oxygen carried in the blood and is routinely monitored during sleep studies. Monitoring oxygen saturation during sleep provides information about oxygen levels throughout the recording period."],
			["material-symbols:trending-down-rounded", "Lowest Oxygen Saturation", "Many sleep study reports include the lowest recorded oxygen saturation observed during the study. This parameter reflects the lowest oxygen level measured during the monitoring period."],
			["material-symbols:pause-circle-outline-rounded", "Apnea", "Apnea refers to a temporary pause in breathing during sleep. Sleep studies may record the number and type of apnea events that occur throughout the night."],
			["material-symbols:compress-rounded", "Hypopnea", "Hypopnea refers to a partial reduction in airflow during sleep. Sleep studies commonly record hypopnea events in addition to apnea events when evaluating breathing patterns."],
			["material-symbols:do-not-disturb-on-outline-rounded", "Obstructive Sleep Apnea (OSA)", "Obstructive Sleep Apnea (OSA) is the most common type of sleep apnea and occurs when the upper airway becomes narrowed or blocked during sleep. OSA is one of the most frequently evaluated conditions in sleep medicine."],
			["material-symbols:neurology-outline-rounded", "Central Sleep Apnea (CSA)", "Central Sleep Apnea (CSA) occurs when breathing disturbances are related to reduced respiratory drive from the central nervous system. CSA differs from OSA in its underlying mechanism."],
			["material-symbols:graphic-eq-rounded", "Snoring", "Many sleep studies record snoring-related information. Snoring may occur independently or alongside other sleep-related breathing disorders."],
			["material-symbols:hotel-outline-rounded", "Body Position During Sleep", "Some sleep studies evaluate body position throughout the night. Sleeping position may influence breathing patterns in certain individuals."],
			["material-symbols:cardiology-outline-rounded", "Heart Rate During Sleep", "Heart rate monitoring is commonly included in sleep studies and provides information regarding heart rate patterns during sleep."],
		],
		resultsTitle: "Understanding Sleep Study Results",
		results: [
			"Sleep studies may contain multiple parameters and measurements that are reviewed collectively by qualified healthcare professionals as part of the overall evaluation process.",
			"Each sleep study is unique, and the significance of individual findings should always be considered within the context of the complete clinical assessment.",
		],
		refsTitle: "Scientific References",
		refs: ["American Academy of Sleep Medicine (AASM)", "American Thoracic Society (ATS)", "Harvard Medical School Sleep Medicine Program"],
		noticeTitle: "Important Notice",
		notice: "The information provided on this page is intended for educational purposes only and is designed to help readers understand common sleep study terminology and parameters. It should not be considered a medical diagnosis, medical interpretation, or treatment recommendation. Individuals should consult their physician or qualified healthcare professional regarding any medical concerns or decisions related to their health.",
	},
	ar: {
		title: "فهم علاج CPAP",
		lead: "تعرّف على كيفية عمل علاج CPAP وكيف يساعد على إبقاء مجرى الهواء مفتوحاً أثناء النوم.",
		toc: "في هذه الصفحة",
		topics: [
			["cpap", "material-symbols:air-rounded", "فهم علاج CPAP", "تعرّف على كيفية عمل علاج CPAP وكيف يساعد على إبقاء مجرى الهواء مفتوحاً أثناء النوم."],
			["bipap", "material-symbols:pulmonology-outline-rounded", "فهم علاج BiPAP", "تعرّف على علاج BiPAP وكيف يختلف عن CPAP واستخداماته الشائعة للمرضى الذين يحتاجون دعماً تنفسياً إضافياً."],
			["mad", "material-symbols:dentistry-outline", "فهم العلاج بأجهزة الفم (MAD)", "تعرّف على أجهزة تقديم الفك السفلي (MAD) ودورها في التعامل مع الشخير وبعض حالات انقطاع النفس الانسدادي أثناء النوم."],
			["equipment", "material-symbols:devices-other-outline-rounded", "اختيار معدات علاج النوم المناسبة", "استكشف معلومات عن أجهزة علاج النوم والأقنعة والملحقات الشائعة في علاج انقطاع النفس أثناء النوم."],
			["getting-started", "material-symbols:rocket-launch-outline-rounded", "البدء بالعلاج", "إرشادات عملية لمن يبدأ علاج النوم، بما في ذلك نصائح مفيدة لتحسين الراحة والتكيّف مع العلاج."],
			["mask-selection", "material-symbols:masks-outline-rounded", "دليل اختيار القناع", "تعرّف على أنواع الأقنعة المختلفة والاعتبارات المهمة عند اختيار القناع المناسب."],
			["cleaning", "material-symbols:cleaning-services-outline-rounded", "التنظيف والصيانة", "إرشادات حول التنظيف الصحيح وصيانة معدات علاج النوم والعناية بها."],
			["faq-tips", "material-symbols:tips-and-updates-outline-rounded", "أسئلة شائعة ونصائح عملية", "اعثر على إجابات للأسئلة المتكررة ونصائح عملية حول معدات علاج النوم والاستخدام اليومي."],
			["resources", "material-symbols:library-books-outline-rounded", "مصادر تعليمية", "اطّلع على مقالات وأدلة وفيديوهات ومواد توعوية حول صحة النوم وعلاجه."],
		] as Topic[],
		links: { cpap: "تصفّح أجهزة CPAP", masks: "أقنعة CPAP والفيديوهات", mad: "أجهزة الفم", videos: "الفيديوهات التدريبية", blog: "مقالات وأدلة" },
		reportsTitle: "فهم تقارير دراسة النوم",
		reportsSub: "فهم المصطلحات والمؤشرات الشائعة في دراسة النوم",
		reportsIntro: [
			"توفّر دراسات النوم معلومات قيّمة عن أنماط التنفس ومستويات الأكسجين ومؤشرات فسيولوجية أخرى أثناء النوم. ويساعد فهم بعض المصطلحات الشائعة على التعرّف على المعلومات التي قد تظهر في تقرير دراسة النوم.",
			"المعلومات التالية لأغراض تثقيفية وتشرح المؤشرات والمصطلحات الشائعة في دراسات النوم.",
		],
		ahiTitle: "مؤشر انقطاع وضعف التنفس (AHI)",
		ahi: [
			"يُعد مؤشر انقطاع وضعف التنفس (AHI) من أكثر المؤشرات استخداماً في دراسات النوم، وهو يمثل تكرار انقطاعات وانخفاضات التنفس التي تحدث أثناء النوم.",
			"يُستخدم AHI على نطاق واسع في طب النوم ويُعتمد عليه عادةً في تصنيف شدة اضطرابات التنفس أثناء النوم.",
		],
		ahiTable: "التصنيف الشائع لمؤشر AHI",
		ahiRows: [["أقل من 5", "طبيعي"], ["5 إلى 14.9", "خفيف"], ["15 إلى 29.9", "متوسط"], ["30 أو أكثر", "شديد"]],
		ahiHead: ["AHI", "التصنيف"],
		terms: [
			["material-symbols:water-drop-outline-rounded", "مؤشر انخفاض الأكسجين (ODI)", "يعكس مؤشر انخفاض الأكسجين (ODI) عدد مرات انخفاض مستوى الأكسجين أثناء النوم، ويُراجع عادةً مع مؤشرات أخرى لفهم التغيرات المتعلقة بالأكسجين أثناء الليل."],
			["material-symbols:spo2-outline-rounded", "تشبّع الأكسجين (SpO₂)", "يمثل تشبّع الأكسجين (SpO₂) نسبة الأكسجين المحمول في الدم، ويُراقب بشكل روتيني في دراسات النوم ليقدّم معلومات عن مستويات الأكسجين طوال فترة التسجيل."],
			["material-symbols:trending-down-rounded", "أدنى تشبّع للأكسجين", "تتضمن كثير من تقارير دراسة النوم أدنى قيمة مسجلة لتشبّع الأكسجين، وهي تعكس أقل مستوى أكسجين تم قياسه خلال فترة المراقبة."],
			["material-symbols:pause-circle-outline-rounded", "انقطاع النفس (Apnea)", "يشير انقطاع النفس إلى توقف مؤقت في التنفس أثناء النوم، وقد تسجّل دراسات النوم عدد ونوع هذه الأحداث خلال الليل."],
			["material-symbols:compress-rounded", "ضعف التنفس (Hypopnea)", "يشير ضعف التنفس إلى انخفاض جزئي في تدفق الهواء أثناء النوم، وتسجّل دراسات النوم عادةً أحداثه إلى جانب أحداث انقطاع النفس."],
			["material-symbols:do-not-disturb-on-outline-rounded", "انقطاع النفس الانسدادي أثناء النوم (OSA)", "يُعد انقطاع النفس الانسدادي النوع الأكثر شيوعاً، ويحدث عندما يضيق مجرى الهواء العلوي أو ينسد أثناء النوم، وهو من أكثر الحالات تقييماً في طب النوم."],
			["material-symbols:neurology-outline-rounded", "انقطاع النفس المركزي (CSA)", "يحدث انقطاع النفس المركزي عندما ترتبط اضطرابات التنفس بانخفاض الدافع التنفسي من الجهاز العصبي المركزي، ويختلف عن OSA في آليته."],
			["material-symbols:graphic-eq-rounded", "الشخير", "تسجّل كثير من دراسات النوم معلومات متعلقة بالشخير، وقد يحدث الشخير منفرداً أو مع اضطرابات تنفس أخرى مرتبطة بالنوم."],
			["material-symbols:hotel-outline-rounded", "وضعية الجسم أثناء النوم", "تقيّم بعض دراسات النوم وضعية الجسم طوال الليل، إذ قد تؤثر وضعية النوم على أنماط التنفس لدى بعض الأشخاص."],
			["material-symbols:cardiology-outline-rounded", "معدل ضربات القلب أثناء النوم", "تتضمن دراسات النوم عادةً مراقبة معدل ضربات القلب، مما يوفّر معلومات عن أنماط نبض القلب أثناء النوم."],
		],
		resultsTitle: "فهم نتائج دراسة النوم",
		results: [
			"قد تحتوي دراسات النوم على عدة مؤشرات وقياسات يراجعها مختصو الرعاية الصحية المؤهلون مجتمعةً كجزء من عملية التقييم الشاملة.",
			"كل دراسة نوم فريدة، ويجب دائماً النظر إلى أهمية كل نتيجة في سياق التقييم السريري الكامل.",
		],
