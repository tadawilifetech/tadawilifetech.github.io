---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { getEntryTranslationKey } from "../utils/locale-utils";
import { getImageFit } from "../utils/image-fit";
import { url as siteUrl } from "../utils/url-utils";
import WishlistButton from "./WishlistButton";

interface Props {
	class?: string;
	entry: CollectionEntry<"products">;
	title: string;
	url: string;
	image: string;
	description: string;
	price: string;
	draft: boolean;
	style: string;
	lang?: string;
}
const {
	entry,
	title,
	url,
	image,
	description,
	price,
	style,
	lang = "en",
} = Astro.props;
const className = Astro.props.class;

const viewDetailsText: Record<string, string> = {
	en: "View Details",
	ar: "عرض التفاصيل",
	fa: "مشاهده جزئیات",
};
const viewDetails = viewDetailsText[lang] ?? viewDetailsText.en;

const category = entry.data.category || "";
const productId = getEntryTranslationKey(entry);
const hasCover = image !== undefined && image !== null && image !== "";
const imgFit = await getImageFit(hasCover ? image : null);
---

<div
	data-product-category={category}
	class:list={["product-card group relative flex flex-col w-full rounded-[var(--radius-large)] overflow-hidden", className]}
	style={style}
>
	{hasCover && (
		<a href={url} aria-label={title} class="product-img-link relative block overflow-hidden aspect-[4/3]" style={`background:${imgFit.bg}`}>
			<!-- Category badge -->
			{category && (
				<span class="product-category-badge absolute top-3 start-3 z-20 px-2.5 py-1 text-xs font-semibold rounded-full
					bg-[oklch(0.5_0.15_var(--hue)/0.88)] text-white backdrop-blur-sm shadow-sm
">
					{category}
				</span>
			)}


			<!-- Image with parallax -->
			<div class="product-img-container absolute inset-0 overflow-hidden">
				<img
					src={image.startsWith("/") ? siteUrl(image) : image}
					alt={title}
					loading="lazy"
					decoding="async"
					class:list={["product-img w-full h-full object-center", imgFit.fit === "contain" ? "object-contain p-[7%]" : "object-cover"]}
				/>
			</div>

			<!-- View detail label on hover -->
			<div class="absolute bottom-3 inset-x-0 z-20 flex justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200">
				<span class="flex items-center gap-1 text-white text-xs font-medium px-3 py-1 rounded-full bg-black/60">
					<Icon name="material-symbols:open-in-new-rounded" class="text-sm" />
					<span>{viewDetails}</span>
				</span>
			</div>
		</a>
	)}

	<!-- Card info -->
	<div class="product-info flex flex-col flex-1 px-5 pt-4 pb-5 bg-[var(--card-bg)] transition-colors duration-300">
		<a
			href={url}
			class="product-title block font-bold mb-2 text-[1.05rem] md:text-[1.1rem] leading-snug text-90 line-clamp-2
				hover:text-[var(--primary)] active:text-[var(--title-active)] transition-colors duration-200"
		>
			{title}
		</a>

		{description && (
			<p class="text-75 text-sm mb-4 line-clamp-2 leading-relaxed flex-1">
				{description}
			</p>
		)}

		<div class="flex items-center justify-between pt-3 mt-auto border-t border-black/5 dark:border-white/5">
			{price ? (
				<div class="flex items-center gap-1.5">
					<Icon name="material-symbols:payments-outline-rounded" class="text-[var(--primary)] text-base opacity-80" />
					<span class="text-sm font-bold text-[var(--primary)]">{price}</span>
				</div>
			) : (
				<span></span>
			)}
			<WishlistButton client:load id={productId} size="sm" />
		</div>
	</div>
</div>

<style>
	.product-card {
		background: var(--card-bg);
		box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
		transition: box-shadow 0.2s ease;
	}
	.product-card:hover { box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1); }
	.product-img-link { border-bottom: 1px solid rgb(0 0 0 / 0.05); }
</style>
