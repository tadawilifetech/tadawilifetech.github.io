---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { getImageFit } from "../utils/image-fit";
import { getEntryTranslationKey } from "../utils/locale-utils";
import { url as siteUrl } from "../utils/url-utils";
import WishlistButton from "./WishlistButton";

interface Props {
	class?: string;
	entry: CollectionEntry<"products">;
	title: string;
	url: string;
	image: string;
	description: string;
	price: string;
	draft: boolean;
	style: string;
	lang?: string;
}
const { entry, title, url, image, description, price, style } = Astro.props;
const className = Astro.props.class;

const category = entry.data.category || "";
const productId = getEntryTranslationKey(entry);
const hasCover = image !== undefined && image !== null && image !== "";
const imgFit = await getImageFit(hasCover ? image : null);
---

<div
	data-product-category={category}
	class:list={["product-card group relative flex flex-col w-full rounded-[var(--radius-large)] overflow-hidden", className]}
	style={style}
>
	{hasCover && (
		<a href={url} aria-label={title} class="product-img-link block p-2 pb-0">
			<span class="product-img-tile relative block overflow-hidden aspect-[4/3]" style={`background:${imgFit.bg}`}>
				<img
					src={image.startsWith("/") ? siteUrl(image) : image}
					alt={title}
					loading="lazy"
					decoding="async"
					class:list={["product-img absolute inset-0 w-full h-full object-center", imgFit.fit === "contain" ? "object-contain p-[8%]" : "object-cover"]}
				/>
			</span>
		</a>
	)}

	<!-- Card info -->
	<div class="product-info flex flex-col flex-1 px-5 pt-4 pb-5">
		{category && <span class="product-category text-xs font-semibold text-[var(--primary)] mb-1.5 truncate">{category}</span>}
		<a
			href={url}
			class="product-title block font-bold mb-2 text-[1.05rem] md:text-[1.1rem] leading-snug text-90 line-clamp-2
				hover:text-[var(--primary)] active:text-[var(--title-active)] transition-colors duration-200"
		>
			{title}
		</a>

		{description && (
			<p class="text-75 text-sm mb-4 line-clamp-2 leading-relaxed flex-1">
				{description}
			</p>
		)}

		<div class="flex items-center justify-between pt-3 mt-auto border-t border-black/5 dark:border-white/5">
			{price ? (
				<div class="flex items-center gap-1.5">
					<Icon name="material-symbols:payments-outline-rounded" class="text-[var(--primary)] text-base opacity-80" />
					<span class="text-sm font-bold text-[var(--primary)]">{price}</span>
				</div>
			) : (
				<span></span>
			)}
			<WishlistButton client:load id={productId} size="sm" />
		</div>
	</div>
</div>

<style>
	.product-card {
		background: var(--card-bg);
		box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
		transition: box-shadow 0.2s ease;
	}
	.product-card:hover { box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1); }
	.product-img-tile {
		border-radius: calc(var(--radius-large) - 0.5rem);
		box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.05);
	}
	/* The inset outline sits above the photo so the tile edge stays crisp on any backdrop */
	.product-img-tile::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06);
		pointer-events: none;
	}
	:global(.dark) .product-img-tile::after { box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08); }
	/* Soften bright studio backdrops so white photos don't glare on the dark theme */
	:global(.dark) .product-img-tile { filter: brightness(0.92); }
</style>
