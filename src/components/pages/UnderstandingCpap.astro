			["material-symbols:compress-rounded", "هیپوپنه", "هیپوپنه به کاهش نسبی جریان هوا در خواب گفته می‌شود و معمولاً همراه با رخدادهای آپنه در ارزیابی الگوی تنفس ثبت می‌شود."],
			["material-symbols:do-not-disturb-on-outline-rounded", "آپنه انسدادی خواب (OSA)", "آپنه انسدادی خواب شایع‌ترین نوع آپنه است و زمانی رخ می‌دهد که راه هوایی فوقانی در خواب تنگ یا مسدود شود؛ این عارضه از پربررسی‌ترین شرایط در طب خواب است."],
			["material-symbols:neurology-outline-rounded", "آپنه مرکزی خواب (CSA)", "آپنه مرکزی زمانی رخ می‌دهد که اختلال تنفس به کاهش فرمان تنفسی از سیستم عصبی مرکزی مربوط باشد و از نظر سازوکار با OSA متفاوت است."],
			["material-symbols:graphic-eq-rounded", "خروپف", "بسیاری از تست‌های خواب اطلاعات مربوط به خروپف را ثبت می‌کنند. خروپف ممکن است به‌تنهایی یا همراه با سایر اختلالات تنفسی خواب رخ دهد."],
			["material-symbols:hotel-outline-rounded", "وضعیت بدن در خواب", "برخی تست‌های خواب وضعیت بدن را در طول شب ارزیابی می‌کنند، زیرا وضعیت خوابیدن ممکن است بر الگوی تنفس برخی افراد اثر بگذارد."],
			["material-symbols:cardiology-outline-rounded", "ضربان قلب در خواب", "پایش ضربان قلب معمولاً بخشی از تست خواب است و اطلاعاتی درباره الگوی ضربان قلب در خواب ارائه می‌دهد."],
		],
		resultsTitle: "آشنایی با نتایج تست خواب",
		results: [
			"تست خواب ممکن است شامل چندین شاخص و اندازه‌گیری باشد که توسط متخصصان واجد شرایط به‌صورت مجموعه‌ای در فرایند ارزیابی کلی بررسی می‌شوند.",
			"هر تست خواب منحصربه‌فرد است و اهمیت هر یافته باید همواره در چارچوب ارزیابی بالینی کامل در نظر گرفته شود.",
		],
		refsTitle: "منابع علمی",
		refs: ["آکادمی طب خواب آمریکا (AASM)", "انجمن قفسه سینه آمریکا (ATS)", "برنامه طب خواب دانشکده پزشکی هاروارد"],
		noticeTitle: "اطلاعیه مهم",
		notice: "اطلاعات این صفحه صرفاً جنبه آموزشی دارد و برای کمک به درک اصطلاحات و شاخص‌های رایج تست خواب طراحی شده است و نباید به‌عنوان تشخیص، تفسیر پزشکی یا توصیه درمانی تلقی شود. افراد باید درباره هرگونه نگرانی یا تصمیم پزشکی مرتبط با سلامت خود با پزشک یا متخصص واجد شرایط مشورت کنند.",
	},
}[locale];

const L = (p: string) => url(localizePath(p, locale));
const topicLinks: Record<string, { href: string; label: string }> = {
	cpap: { href: L("/products/heyer-auto-cpap-machine/"), label: c.links.cpap },
	bipap: { href: L("/products/heyer-bipap/"), label: "Heyer BiPAP" },
	mad: { href: L("/products/oniris-mandibular-advancement-device/"), label: c.links.mad },
	equipment: { href: L("/#products"), label: c.links.cpap },
	"mask-selection": { href: L("/products/cpap-mask/"), label: c.links.masks },
	cleaning: { href: L("/training-resources/"), label: c.links.videos },
	resources: { href: L("/blog/"), label: c.links.blog },
};
const severity = ["#16a34a", "#eab308", "#f97316", "#e5484d"];
const toc = [...c.topics.map(([id, , title]) => [id, title]), ["sleep-study-reports", c.reportsTitle]];
---
<PageHero icon="material-symbols:air-rounded" title={c.title} lead={c.lead} />

<div class="grid grid-cols-1 lg:grid-cols-[15rem_1fr] gap-6 items-start">
    <nav class="hidden lg:block sticky top-6 card-base p-4" aria-label={c.toc}>
        <p class="text-xs font-bold uppercase tracking-wider text-50 px-2 mb-2">{c.toc}</p>
        <ol class="flex flex-col gap-0.5 text-sm">
            {toc.map(([id, title]) => (
                <li><a href={`#${id}`} class="toc-link block rounded-lg px-2 py-1.5 text-75 hover:text-[var(--primary)] hover:bg-[var(--btn-plain-bg-hover)] transition" data-toc={id}>{title}</a></li>
            ))}
        </ol>
    </nav>

    <div class="flex flex-col gap-4 min-w-0">
        {c.topics.map(([id, icon, title, text], i) => (
            <section id={id} class="card-base reading-surface scroll-mt-24 p-6 md:p-8 flex flex-col sm:flex-row gap-5" data-reveal data-toc-section>
                <span class="topic-visual" style={`--h:${230 + i * 9}`}><Icon name={icon} class="text-4xl" /></span>
                <div class="flex-1">
                    <h2 class="text-xl font-extrabold text-90">{title}</h2>
                    <p class="text-75 leading-loose mt-2">{text}</p>
                    {topicLinks[id] && (
                        <a href={topicLinks[id].href} class="inline-flex items-center gap-1.5 mt-3 text-sm font-bold text-[var(--primary)] hover:gap-2.5 transition-all">
                            {topicLinks[id].label} <Icon name="material-symbols:arrow-forward-rounded" class="rtl:rotate-180" />
                        </a>
                    )}
                </div>
            </section>
        ))}

        <!-- Sleep study reports -->
        <section id="sleep-study-reports" class="scroll-mt-24 mt-6 flex flex-col gap-4" data-toc-section>
            <div class="px-1" data-reveal>
                <p class="section-eyebrow">{c.reportsSub}</p>
                <h2 class="section-title mt-2">{c.reportsTitle}</h2>
            </div>
            <div class="card-base reading-surface p-6 md:p-8" data-reveal>
                {c.reportsIntro.map((p) => <p class="text-75 leading-loose mb-3 last:mb-0">{p}</p>)}
            </div>

            <div class="card-base p-6 md:p-8" data-reveal>
                <h3 class="flex items-center gap-3 text-xl font-extrabold text-90"><span class="icon-badge"><Icon name="material-symbols:monitoring-rounded" class="text-2xl" /></span>{c.ahiTitle}</h3>
                {c.ahi.map((p) => <p class="text-75 leading-loose mt-3">{p}</p>)}
                <h4 class="font-bold text-90 mt-6 mb-3">{c.ahiTable}</h4>
                <div class="ahi-scale" dir="ltr">
                    {c.ahiRows.map(([range, label], i) => (
                        <div class="ahi-cell" style={`--c:${severity[i]}; --i:${i}`}>
                            <span class="ahi-bar"></span>
                            <span class="ahi-label" dir="auto">{label}</span>
                            <span class="ahi-range" dir="auto">{c.ahiHead[0]} {range}</span>
                        </div>
                    ))}
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {c.terms.map(([icon, title, text], i) => (
                    <div class="card-base lift-card p-6 flex gap-4" data-reveal data-reveal-delay={String((i % 2) * 90)}>
                        <span class="icon-badge"><Icon name={icon} class="text-2xl" /></span>
                        <div>
                            <h3 class="font-extrabold text-90">{title}</h3>
                            <p class="text-sm text-75 leading-relaxed mt-1.5">{text}</p>
                        </div>
                    </div>
                ))}
            </div>

            <div class="card-base reading-surface p-6 md:p-8" data-reveal>
                <h3 class="text-xl font-extrabold text-90 mb-3">{c.resultsTitle}</h3>
                {c.results.map((p) => <p class="text-75 leading-loose mb-3 last:mb-0">{p}</p>)}
                <h4 class="font-bold text-90 mt-6 mb-3">{c.refsTitle}</h4>
                <ul class="flex flex-wrap gap-2">
                    {c.refs.map((r) => <li class="chip !h-auto py-2"><Icon name="material-symbols:menu-book-outline-rounded" /> {r}</li>)}
                </ul>
            </div>

            <div class="notice-card rounded-[var(--radius-large)] p-6 md:p-8" data-reveal>
                <h3 class="flex items-center gap-3 text-lg font-extrabold mb-2"><Icon name="material-symbols:info-outline-rounded" class="text-2xl" />{c.noticeTitle}</h3>
                <p class="leading-loose text-sm md:text-base">{c.notice}</p>
            </div>
        </section>
    </div>
</div>

<style>
    .topic-visual {
        flex-shrink: 0;
        display: grid;
        place-items: center;
        width: 5rem;
        height: 5rem;
        border-radius: 1.4rem;
        color: white;
        background: linear-gradient(140deg, oklch(0.5 0.17 var(--h)), oklch(0.65 0.13 calc(var(--h) - 40)));
        box-shadow: 0 12px 26px oklch(0.45 0.15 var(--h) / 0.3);
    }
    .ahi-scale { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; }
    @media (max-width: 640px) { .ahi-scale { grid-template-columns: repeat(2, 1fr); } }
    .ahi-cell { display: flex; flex-direction: column; gap: 0.4rem; padding: 0.9rem; border-radius: 1rem; background: color-mix(in oklch, var(--c) 10%, transparent); }
    .ahi-bar { height: 0.5rem; border-radius: 999px; background: var(--c); transform-origin: left; animation: bar-grow 1s cubic-bezier(0.23, 1, 0.32, 1) both; animation-delay: calc(var(--i) * 140ms + 200ms); }
    @keyframes bar-grow { from { transform: scaleX(0); } }
    .ahi-label { font-weight: 800; color: var(--c); font-size: 1.05rem; }
    .ahi-range { font-size: 0.82rem; opacity: 0.75; }
    .toc-link.is-current { color: var(--primary); background: var(--btn-plain-bg-hover); font-weight: 700; }
    .notice-card { background: oklch(0.96 0.04 85); color: oklch(0.38 0.08 70); border: 1px solid oklch(0.88 0.08 85); }
    :global(.dark) .notice-card { background: oklch(0.27 0.04 80); color: oklch(0.88 0.08 85); border-color: oklch(0.38 0.06 80); }
</style>

<script>
function initToc() {
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc]");
    if (!links.length) return;
    const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
            if (!e.isIntersecting) continue;
            links.forEach((l) => l.classList.toggle("is-current", l.dataset.toc === e.target.id));
        }
    }, { rootMargin: "-30% 0px -60% 0px" });
    document.querySelectorAll("[data-toc-section]").forEach((s) => io.observe(s));
}
initToc();
const bind = () => window.swup?.hooks.on("page:view", initToc);
if (window.swup?.hooks) bind();
else document.addEventListener("swup:enable", bind, { once: true });
</script>
