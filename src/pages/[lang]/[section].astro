---
import SectionPage from "@components/pages/SectionPage.astro";
import { SECTION_KEYS, type SectionKey, navItem } from "@constants/site-nav";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { SUPPORTED_LOCALES, type SiteLocale } from "@utils/locale-utils";

export function getStaticPaths() {
	return SUPPORTED_LOCALES.flatMap((lang) => SECTION_KEYS.map((section) => ({ params: { lang, section } })));
}

const locale = Astro.params.lang as SiteLocale;
const section = Astro.params.section as SectionKey;
const item = navItem(section);
const catalogTitle = { en: "Orthopedic Catalog", ar: "كتالوج دعامات العظام", fa: "کاتالوگ ارتوپدی" }[locale];
const title = item?.label[locale] ?? catalogTitle;
---

<MainGridLayout title={title} description={item?.desc[locale] ?? title} lang={locale}>
	<SectionPage section={section} locale={locale} />
</MainGridLayout>
