---
import ContactView from "@components/pages/ContactView.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { DEFAULT_LOCALE, SUPPORTED_LOCALES, normalizeLocale } from "@utils/locale-utils";

export async function getStaticPaths() {
	return SUPPORTED_LOCALES.map((lang) => ({ params: { lang } }));
}

const currentLocale = normalizeLocale(Astro.params.lang || DEFAULT_LOCALE);
---

<MainGridLayout title={i18n(I18nKey.contact, currentLocale)} description={i18n(I18nKey.contact, currentLocale)} lang={currentLocale}>
	<ContactView locale={currentLocale} />
</MainGridLayout>
