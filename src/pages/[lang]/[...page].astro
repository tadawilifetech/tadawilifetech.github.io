---
import type { GetStaticPaths } from "astro";
import HomePage from "@components/home/HomePage.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedProducts } from "@utils/content-utils";
import { SUPPORTED_LOCALES, type SiteLocale } from "@utils/locale-utils";

export const getStaticPaths = (async () => {
	const paths = [];
	for (const lang of SUPPORTED_LOCALES) {
		paths.push({ params: { lang, page: undefined }, props: { products: await getSortedProducts(lang) } });
	}
	return paths;
}) satisfies GetStaticPaths;

const { products } = Astro.props;
const currentLocale = Astro.params.lang as SiteLocale;
---

<MainGridLayout lang={currentLocale}>
	<HomePage locale={currentLocale} products={products} />
</MainGridLayout>
