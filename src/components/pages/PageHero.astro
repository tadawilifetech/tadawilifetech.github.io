---
import { Icon } from "astro-icon/components";

interface Props {
	icon: string;
	eyebrow?: string;
	title: string;
	lead?: string;
}
const { icon, eyebrow, title, lead } = Astro.props;
---
<header class="page-hero relative overflow-hidden rounded-[var(--radius-large)] px-6 md:px-12 py-10 md:py-14 mb-6 text-white" data-reveal="scale">
    <span class="page-hero-orb page-hero-orb--a" aria-hidden="true"></span>
    <span class="page-hero-orb page-hero-orb--b" aria-hidden="true"></span>
    <span class="page-hero-grid" aria-hidden="true"></span>
    <img src="/logo-tadawi.svg" alt="" class="page-hero-logo" aria-hidden="true" />
    <div class="relative z-10 flex flex-col md:flex-row md:items-center gap-6">
        <span class="page-hero-icon"><Icon name={icon} class="text-4xl" /></span>
        <div class="min-w-0">
            {eyebrow && <p class="text-xs md:text-sm font-bold tracking-widest uppercase opacity-80 mb-2">{eyebrow}</p>}
            <h1 class="text-3xl md:text-[2.6rem] font-black leading-tight" data-pagefind-meta="title">{title}</h1>
            {lead && <p class="mt-3 text-base md:text-lg opacity-85 max-w-3xl leading-relaxed">{lead}</p>}
            <slot />
        </div>
    </div>
</header>

<style>
    .page-hero {
        background: linear-gradient(125deg, oklch(0.3 0.12 272) 0%, oklch(0.42 0.17 265) 45%, oklch(0.55 0.14 228) 100%);
        box-shadow: 0 20px 50px oklch(0.35 0.15 268 / 0.3);
    }
    .page-hero-orb { position: absolute; border-radius: 999px; filter: blur(40px); opacity: 0.55; animation: hero-float 14s ease-in-out infinite; }
    .page-hero-orb--a { width: 18rem; height: 18rem; inset-inline-end: -4rem; top: -6rem; background: oklch(0.72 0.14 215); }
    .page-hero-orb--b { width: 14rem; height: 14rem; inset-inline-start: 30%; bottom: -8rem; background: oklch(0.6 0.2 290); animation-delay: -6s; }
    .page-hero-grid {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgb(255 255 255 / 0.16) 1px, transparent 1px);
        background-size: 22px 22px;
        mask-image: linear-gradient(120deg, transparent 20%, black 70%);
    }
    .page-hero-logo { position: absolute; inset-inline-end: 2rem; bottom: 1.2rem; height: 2.4rem; opacity: 0.18; filter: brightness(0) invert(1); }
    .page-hero-icon {
        display: grid;
        place-items: center;
        width: 4.75rem;
        height: 4.75rem;
        flex-shrink: 0;
        border-radius: 1.4rem;
        background: rgb(255 255 255 / 0.14);
        border: 1px solid rgb(255 255 255 / 0.25);
        backdrop-filter: blur(10px);
        animation: icon-breathe 6.5s ease-in-out infinite;
    }
    @keyframes hero-float { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(-20px, 18px); } }
    @keyframes icon-breathe { 0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgb(255 255 255 / 0.18); } 50% { transform: scale(1.05); box-shadow: 0 0 0 14px rgb(255 255 255 / 0); } }
    @media (prefers-reduced-motion: reduce) { .page-hero-orb, .page-hero-icon { animation: none; } }
</style>
